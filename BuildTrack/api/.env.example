APP_NAME=BuildTrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local: SQLite file in database/database.sqlite.
# Production (Hostinger MySQL): switch to the block below and fill in the values from hPanel.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=u540637169_buildtrack
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Only used by "php artisan buildtrack:import-legacy" when no path is given.
LEGACY_SQLITE_PATH=../backend/BuildTrack.Api/buildtrack.db

# Used once by the seeder to create the first admin. Leave empty to get a random password.
ADMIN_PASSWORD=
