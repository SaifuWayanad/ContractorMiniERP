{
  "expo": {
    "name": "Build Mate",
    "slug": "buildmate",
    "version": "1.0.0",
    "scheme": "buildmate",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B2A4A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buildmate.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B2A4A",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.buildmate.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B2A4A",
          "image": "./assets/icon.png",
          "imageWidth": 200
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d547f4fd-c429-4bdd-af0f-c4d5c3859e74"
      }
    },
    "owner": "thasnakthaj"
  }
}
